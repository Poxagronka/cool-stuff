# telegram mtproto — backfill only. reuse the pair from any project of yours:
# they are issued per account, not per application.
TG_API_ID=
TG_API_HASH=

# separate bot for this project. one token carries one webhook url, so do not
# reuse a token that already serves another bot.
TG_BOT_TOKEN=

# chat to harvest: numeric id (-100...) or @username. the web app will not
# start without it — it is the only thing telling our updates apart from a
# stranger's dm to the bot, and both arrive signed the same way.
TG_CHAT=

# the header telegram signs webhook calls with, set through setWebhook. also
# refused at startup when empty: /webhook writes notes, and without a secret
# anyone who finds the url can make it do that. any long random string.
WEBHOOK_SECRET=

# model providers. the free ones do the work, anthropic is the fallback for
# when they are out of quota. keys are free to get: console.groq.com,
# aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=

# who answers what, tried left to right. "provider/model", comma separated.
# defaults live in ask.py / categorize.py / pipeline.py
# SEARCH_CHAIN=
# SORT_CHAIN=
# TRIAGE_CHAIN=

DB_PATH=data/links.db
VAULT_PATH=data/vault

# the telethon user session, shared by scripts/login.py, scripts/backfill.py
# and the scheduled saved-messages pull. on fly this has to sit on the volume
# (/data/backfill.session): the root filesystem is ephemeral and there is no
# terminal up there to sign in again. see SETUP.md.
# TG_SESSION=data/backfill.session

# minutes between saved-messages pulls. checked whenever the machine happens
# to be awake, never on a timer. 0 leaves only the trigger route.
# SAVED_EVERY_MINUTES=180

# seconds allowed for one fetch of a page we are enriching
# HTTP_TIMEOUT=20

# the free mymemory translator that sits in front of the search box. an email
# on the request raises their ceiling from 5000 characters a day to 50000, and
# the budget below is what we allow ourselves out of it.
# TRANSLATE_EMAIL=
# TRANSLATE_DAILY_CHARS=40000
# TRANSLATE_TIMEOUT=5

# vault git remote, used by the fly app to push notes
VAULT_REPO=
GITHUB_TOKEN=

# the private half of the vault deploy key, newlines and all. on fly it is a
# secret; the app writes it out to SSH_KEY_PATH, which has to be on the volume.
SSH_KEY=
# SSH_KEY_PATH=/data/.ssh/id_ed25519
